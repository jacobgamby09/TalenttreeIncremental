{
  "name": "talenttreeincremental",
  "version": "0.1.0",
  "private": true,
  "description": "Incremental RPG where the talent tree is the whole game world. Prototype in plain JavaScript with no build step.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "simulate": "node tools/simulate.mjs 20 --write",
    "check:assets": "node tools/check-assets.mjs",
    "asset-list": "node tools/make-asset-list.mjs",
    "check": "npm test && npm run check:assets"
  }
}
